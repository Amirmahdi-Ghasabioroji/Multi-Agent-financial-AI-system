# Dashboard database (local Docker only; replace before first start)
MYSQL_DATABASE=mafas
MYSQL_USER=mafas
MYSQL_PASSWORD=<strong-password>
MYSQL_ROOT_PASSWORD=<strong-password>

# Application services
# Compose constructs DATABASE_URL from the MySQL values above.
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=financial_docs
# host.docker.internal works on Docker Desktop; on Linux use your host machine IP instead.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=mistral
CACHE_DIR=/app/mafas/data/cache

# Optional external data providers
FRED_API_KEY=
TWELVE_DATA_API_KEY=
EXECUTION_ACCOUNT_EQUITY=100000

# Browser/API configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
CORS_ORIGINS=http://localhost:3000
JOB_MAX_WORKERS=1
